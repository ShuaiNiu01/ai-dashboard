# Client-side demo only: NEXT_PUBLIC_ exposes these values to the browser bundle.
# In a production app, proxy these requests through a backend route instead.

# ------------------------------------------------------------------------------
# Primary provider option A: Google Gemini
# If this key exists, the app uses Google as the main provider.
# Example:
# NEXT_PUBLIC_GOOGLE_API_KEY=AIzaSyExampleGoogleKey1234567890
# NEXT_PUBLIC_GOOGLE_MODEL=gemini-2.0-flash
# NEXT_PUBLIC_GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_MODEL=gemini-2.5-flash-lite
NEXT_PUBLIC_GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# Primary provider option B: OpenRouter
# If Google API key is empty and this key exists, the app uses OpenRouter directly.
# This means testers can fill ONLY NEXT_PUBLIC_OPENROUTER_API_KEY and start using it.
# Example minimal setup:
# NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-example1234567890
#
# Optional OpenRouter settings:
# NEXT_PUBLIC_OPENROUTER_MODEL=google/gemma-3-4b-it:free
# NEXT_PUBLIC_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_MODEL=google/gemma-3-4b-it:free
NEXT_PUBLIC_OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Final fallback provider: optional
# Leave NEXT_PUBLIC_FALLBACK_AI_PROVIDER empty to disable fallback entirely.
# Only this final fallback needs all 4 fields below.
#
# Example 1: fallback to OpenRouter / any OpenAI-compatible endpoint
# NEXT_PUBLIC_FALLBACK_AI_PROVIDER=openai
# NEXT_PUBLIC_FALLBACK_API_URL=https://openrouter.ai/api/v1/chat/completions
# NEXT_PUBLIC_FALLBACK_API_KEY=sk-or-v1-example1234567890
# NEXT_PUBLIC_FALLBACK_API_MODEL=google/gemma-3-4b-it:free
#
# Example 2: fallback to Google Gemini
# NEXT_PUBLIC_FALLBACK_AI_PROVIDER=google
# NEXT_PUBLIC_FALLBACK_API_URL=https://generativelanguage.googleapis.com/v1beta
# NEXT_PUBLIC_FALLBACK_API_KEY=AIzaSyExampleGoogleKey1234567890
# NEXT_PUBLIC_FALLBACK_API_MODEL=gemini-2.0-flash
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FALLBACK_AI_PROVIDER=
NEXT_PUBLIC_FALLBACK_API_URL=
NEXT_PUBLIC_FALLBACK_API_KEY=
NEXT_PUBLIC_FALLBACK_API_MODEL=
